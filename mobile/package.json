{
  "name": "my-demo-app-mobile-tests",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO end-to-end tests for the Sauce Labs My Demo App (Android)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.android.conf.js",
    "test:smoke": "wdio run ./wdio.android.conf.js --mochaOpts.grep @smoke",
    "test:regression": "wdio run ./wdio.android.conf.js --mochaOpts.grep @regression",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@wdio/allure-reporter": "9.33.1",
    "@wdio/appium-service": "9.33.1",
    "@wdio/cli": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "allure-commandline": "2.34.1",
    "appium": "2.19.0",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  }
}
